# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase (client-side — also set in client/.env)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Frontend
VITE_API_BASE_URL=/api

# Server
PORT=3001
FIREBASE_PROJECT_ID=your_project_id
# Optional auth strategies for Firebase Admin SDK (use ONE approach):
# 1) stringified service-account JSON:
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
# 2) base64-encoded service-account JSON:
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Iiwi...
# 3) split credential fields (private key must keep \n escapes):
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
CORS_ORIGIN=https://your-app.vercel.app
